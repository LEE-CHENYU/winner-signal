# Copy to .env; never commit keys. Gallery and analytics require no model key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
# Enable only with working API access and configured current model rates.
ENABLE_LIVE_ANALYSIS=0
MAX_ANALYSIS_USD=0.25
INPUT_USD_PER_MILLION=0
OUTPUT_USD_PER_MILLION=0
MAX_OUTPUT_TOKENS=6000
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=0
# For HTTPS deployment, set COOKIE_SECURE=1 and PUBLIC_ORIGIN to the exact origin.

# Separate Winner Signal OAuth client; never reuse EasyCircuit credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Fernet key for encrypted YouTube refresh tokens; keep stable across deploys.
OAUTH_TOKEN_ENCRYPTION_KEY=
